{
  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY",
    "Issuer": "FindlyApi",
    "Audience": "FindlyAdminPanel",
    "ExpiresInMinutes": 120
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "N8n": { 
    "WebhookUrl": "YOUR_N8N_WEBHOOK_URL",
    "Secret": "YOUR_N8N_SECRET"
  },

  "AllowedHosts": "*"
}

